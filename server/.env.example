# ==========================================
# Hydroponic Smart Farm - Render Server Environment Config
# ==========================================

PORT=3000

# ThingsBoard Cloud หรือ Self-hosted
THINGSBOARD_URL=https://eu.thingsboard.cloud
THINGSBOARD_USERNAME=your_thingsboard_tenant_email@example.com
THINGSBOARD_PASSWORD=your_thingsboard_tenant_password

# Firebase Realtime Database & Service Account
FIREBASE_DATABASE_URL=https://smart-water-farm-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"smart-water-farm","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Secret Key สำหรับ cron-job.org เพื่อสั่งงานรายชั่วโมง
JOB_SECRET=your_super_secret_cron_key_random_string

# Gemini AI (สำหรับฟังก์ชันวิเคราะห์การปลูกพืช)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=3

# ขีดจำกัดความปลอดภัย
MAX_PUMP_SECONDS=10
ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost

